{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appw",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f821bbbe-6ba3-4042-a1b2-899b0a0aa4dc","database_name": "nice" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "406663b2d06b4742b0c7a76eab2a2e72" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
